[Unit]
Description=ChildBEx Keycloak stable release check for Prometheus
Documentation=https://github.com/Rudchyk/childbex
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/keycloak/bin/kc.sh

[Service]
Type=oneshot
# No explicit User=root/Group=root: the privileged oneshot runs as root
# by systemd default, then runuser enters the unprivileged keycloak account.
# Explicit root identity plus sandboxing reproduced "cannot set user id".
ExecStart=/usr/local/sbin/childbex-keycloak-release-check
TimeoutStartSec=45s
UMask=0077

# ChildBEx Keycloak CLI is launched as the unprivileged keycloak user via runuser.
# Only the dedicated Node Exporter textfile directory may be written.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/opt/keycloak
ReadWritePaths=/var/lib/node_exporter/textfile_collector
Nice=10
